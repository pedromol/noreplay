{
  "manifest_version": 3,
  "name": "NoReplay",
  "version": "0.1.0",
  "description": "Pula videos do YouTube ja assistidos, com 5 segundos para rever.",
  "browser_specific_settings": {
    "gecko": {
      "id": "noreplay@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["authenticationInfo", "browsingActivity"]
      }
    }
  },
  "permissions": ["storage", "webNavigation"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": [
        "lib/skip-core.js",
        "content/navigator.js",
        "content/progress.js",
        "content/skip.js"
      ],
      "css": ["content/skip.css"],
      "run_at": "document_idle"
    }
  ]
}
