{
  "manifest_version": 3,
  "name": "NoReplay",
  "version": "0.1.3",
  "description": "Pula videos do YouTube ja assistidos, com 5 segundos para rever.",
  "browser_specific_settings": {
    "gecko": {
      "id": "noreplay@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["authenticationInfo", "browsingActivity"]
      }
    }
  },
  "permissions": ["storage", "webNavigation", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://noreplay.local/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": [
        "lib/skip-core.js",
        "lib/hide-watched-core.js",
        "content/navigator.js",
        "content/progress.js",
        "content/skip.js",
        "content/hide-watched.js"
      ],
      "css": ["content/skip.css", "content/hide-watched.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/feed/history*",
        "https://m.youtube.com/feed/history*"
      ],
      "js": ["content/history.js"],
      "css": ["content/history.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "NoReplay"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
