{
  "name": "noreplay",
  "version": "0.1.14",
  "private": true,
  "description": "NoReplay Firefox extension: skip YouTube videos you already watched.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/",
    "lint": "eslint .",
    "lint:manifest": "web-ext lint --ignore-files 'tests' 'tests/**' 'eslint.config.js' 'package.json' 'package-lock.json' 'README.md' 'docs' 'docs/**' 'AGENTS.md' 'build.sh' 'scripts' 'scripts/**'",
    "build": "web-ext build --overwrite-dest --ignore-files 'tests' 'tests/**' 'eslint.config.js' 'package.json' 'package-lock.json' 'README.md' 'docs' 'docs/**' 'AGENTS.md' 'build.sh' 'scripts' 'scripts/**'",
    "bump:patch": "node scripts/bump-version.js",
    "sign": "node scripts/bump-version.js && web-ext sign --artifacts-dir=./web-ext-artifacts --channel=unlisted --api-key=\"$AMO_JWT_ISSUER\" --api-secret=\"$AMO_JWT_SECRET\" --ignore-files 'tests' 'tests/**' 'eslint.config.js' 'package.json' 'package-lock.json' 'README.md' 'docs' 'docs/**' 'AGENTS.md' 'build.sh' 'scripts' 'scripts/**'",
    "build:sign": "npm run sign"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "web-ext": "^8.3.0"
  }
}
